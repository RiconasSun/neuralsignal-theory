"""Hypothetical Gaussian animal-effect scenarios; no empirical neural inputs."""
import csv,io
from scipy.stats import t,nct

def table():
 out=io.StringIO(newline='');w=csv.writer(out,lineterminator='\n')
 w.writerow(['n_mice','hypothetical_mouse_SD','hypothetical_mean','hypothetical_t95_full_width','hypothetical_two_sided_power_alpha_05','hypothetical_power_bonferroni_3'])
 for n in [6,12,18,24,27]:
  for sd in [.002,.005,.01,.02]:
   for delta in [0,.001,.002,.005,.01]:
    power=lambda alpha:float(1-nct.cdf(t.ppf(1-alpha/2,n-1),n-1,delta*n**.5/sd)+nct.cdf(-t.ppf(1-alpha/2,n-1),n-1,delta*n**.5/sd))
    w.writerow([n,sd,delta,format(2*t.ppf(.975,n-1)*sd/n**.5,'.12g'),format(power(.05),'.12g'),format(power(.05/3),'.12g')])
 return out.getvalue()

if __name__=='__main__':print(table(),end='')
