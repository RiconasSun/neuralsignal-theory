"""Render completed Markdown paper artifacts; no neural data or statistical code."""
import argparse
import html
from pathlib import Path
import re
from reportlab.lib import colors
from reportlab.lib.enums import TA_CENTER
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from reportlab.lib.units import inch
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, LongTable, TableStyle, Image, PageBreak, KeepTogether
from pypdf import PdfReader


def render(source, target, images=False):
    source=Path(source);target=Path(target)
    if target.exists():raise FileExistsError(target)
    styles=getSampleStyleSheet()
    styles.add(ParagraphStyle(name='PaperTitle',fontName='Helvetica-Bold',fontSize=18,leading=22,spaceAfter=15))
    styles.add(ParagraphStyle(name='BodyPaper',fontName='Helvetica',fontSize=9.4,leading=13.5,spaceAfter=7))
    styles.add(ParagraphStyle(name='CellPaper',fontName='Helvetica',fontSize=7,leading=9))
    styles.add(ParagraphStyle(name='HeaderPaper',fontName='Helvetica-Bold',fontSize=7,leading=9,textColor=colors.white))
    styles.add(ParagraphStyle(name='CaptionPaper',fontName='Helvetica',fontSize=8,leading=10,spaceAfter=8))
    def clean(s):
        s=s.replace('\u2264','<=').replace('\u00d7',' x ').replace('\u2212','-').replace('\u2013','-').replace('\u2014',' - ').replace('\u2011','-').replace('\u2019',"'").replace('\u201c','"').replace('\u201d','"').replace('\u03bc','u').replace('\u2013','-')
        s=re.sub(r'\[([^\]]+)\]\(([^)]+)\)',r'\1 (\2)',s)
        s=s.replace('**','').replace('`','')
        return html.escape(s)
    story=[];lines=source.read_text(encoding='utf-8').splitlines();i=0
    while i<len(lines):
        line=lines[i].strip()
        if not line:i+=1;continue
        if line.startswith('```'):
            code=[];i+=1
            while i<len(lines) and not lines[i].startswith('```'):code.append(lines[i]);i+=1
            story.append(Paragraph(clean(' '.join(code)),styles['BodyPaper']));i+=1;continue
        if line.startswith('|'):
            rows=[]
            while i<len(lines) and lines[i].strip().startswith('|'):
                parts=[s.strip() for s in lines[i].strip().strip('|').split('|')]
                if not all(re.fullmatch(r':?-+:?',s) for s in parts):rows.append(parts)
                i+=1
            cols=len(rows[0]);width=6.85*inch
            if cols>=7:widths=[width/cols]*cols
            elif cols==2:widths=[width*.28,width*.72]
            else:widths=[width/cols]*cols
            data=[[Paragraph(clean(s),styles['HeaderPaper'] if r==0 else styles['CellPaper']) for s in row] for r,row in enumerate(rows)]
            tab=LongTable(data,colWidths=widths,repeatRows=1,hAlign='LEFT',splitByRow=True)
            tab.setStyle(TableStyle([('BACKGROUND',(0,0),(-1,0),colors.HexColor('#245472')),('ROWBACKGROUNDS',(0,1),(-1,-1),[colors.white,colors.HexColor('#f1f5f7')]),('VALIGN',(0,0),(-1,-1),'TOP'),('LEFTPADDING',(0,0),(-1,-1),4),('RIGHTPADDING',(0,0),(-1,-1),4),('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5),('LINEBELOW',(0,0),(-1,0),.4,colors.HexColor('#245472'))]))
            story.extend([tab,Spacer(1,9)]);continue
        if line.startswith('# '):style=styles['PaperTitle'];line=line[2:]
        elif line.startswith('### '):style=styles['Heading3'];line=line[4:]
        elif line.startswith('## '):style=styles['Heading2'];line=line[3:]
        else:
            style=styles['BodyPaper']
            while i+1<len(lines) and lines[i+1].strip() and not lines[i+1].lstrip().startswith(('#','|','```')):
                i+=1;line+=' '+lines[i].strip()
        story.append(Paragraph(clean(line),style));i+=1
    if images:
        for name,caption in [('figure1_final_mouse_effects','Figure 1. Every final mouse difference and equal-mouse mean with 95% whole-mouse interval. Holm p values adjust the four primary contrasts.'),('figure2_development_final','Figure 2. Development exploratory versus held-out-mouse estimates. These distinct cohorts are not pooled for selection or inference.'),('figure3_sensitivities','Figure 3. All five mandatory views with their descriptive whole-mouse intervals. No view replaces a failed primary test.'),('figure4_conditional_nulls','Figure 4. Pooled observed gains (diamonds) and conditional null means/ranges (gray). Reference ranges are not mouse bootstrap confidence intervals.')]:
            story.append(PageBreak());path=source.parent/'figures'/(name+'.png')
            from PIL import Image as PILImage
            with PILImage.open(path) as im:w,h=im.size
            width=6.5*inch;height=width*h/w
            if height>7.1*inch:height=7.1*inch;width=height*w/h
            story.extend([Image(str(path),width=width,height=height),Spacer(1,9),Paragraph(clean(caption),styles['CaptionPaper'])])
    def footer(canvas,doc):
        canvas.saveState();canvas.setFillColor(colors.HexColor('#546776'));canvas.setFont('Helvetica',7)
        canvas.drawString(.7*inch,.4*inch,'P12 | Predictive Structure | Scientific manuscript draft')
        canvas.drawRightString(7.55*inch,.4*inch,str(doc.page));canvas.restoreState()
    doc=SimpleDocTemplate(str(target),pagesize=(8.25*inch,11.7*inch),rightMargin=.7*inch,leftMargin=.7*inch,topMargin=.65*inch,bottomMargin=.7*inch,title='Predictive Structure of Neural Population Activity Across Mouse Hippocampal Subfields',author='Author metadata pending project-owner confirmation')
    doc.build(story,onFirstPage=footer,onLaterPages=footer)
    reader=PdfReader(target)
    text='\n'.join(p.extract_text() or '' for p in reader.pages)
    if 'Predictive Structure' not in text or len(text)<1000:raise RuntimeError('PDF_CONTENT_CHECK')
    return {'file':str(target),'pages':len(reader.pages),'extracted_characters':len(text)}


if __name__=='__main__':
    import json
    p=argparse.ArgumentParser();p.add_argument('--directory',required=True);a=p.parse_args();d=Path(a.directory)
    print(json.dumps([render(d/'MANUSCRIPT.md',d/'P12_Manuscript.pdf',True),render(d/'SUPPLEMENT.md',d/'P12_Supplement.pdf')]))
